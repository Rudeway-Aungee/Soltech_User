# ---------------------------------------------------------------------------
# SOLTECH SECURITY + FLUTTER MONOREPO .gitignore
# ---------------------------------------------------------------------------

# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Flutter generated plugin files
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/.dart_tool/
**/build/

# Android / Gradle
.gradle/
**/.gradle/
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# Android signing keys - VERY IMPORTANT
**/android/key.properties
**/key.properties
*.jks
*.keystore
*.p12
*.pem

# iOS / macOS generated files
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/ephemeral/
**/macos/Pods/

# Xcode user files
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/

# Web build output
**/web/.dart_tool/
**/build/web/

# Firebase Admin / backend secrets - VERY IMPORTANT
serviceAccountKey.json
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
adminsdk*.json
google-cloud-key.json
gcloud-key.json

# Environment files - VERY IMPORTANT
.env
.env.*
*.env
!.env.example

# API key / secret local config files
secrets.json
secrets.yaml
secrets.yml
config.secret.json
local_config.dart
local_secrets.dart
api_keys.dart
api_keys_local.dart

# Backend dependencies and build output
backend/node_modules/
backend/.env
backend/.env.*
backend/dist/
backend/build/
backend/logs/
backend/*.log

# Firebase local emulator data
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log

# IDE / editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo